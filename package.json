{
  "name": "subscription-calculator-obsidian",
  "version": "0.11.0",
  "description": "Obsidian plugin for local subscription tracking.",
  "private": true,
  "license": "MIT",
  "main": "main.js",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "dev:reload": "node esbuild.config.mjs --watch-reload",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "build:reload": "npm run build && node esbuild.config.mjs --reload-only",
    "test": "tsc --noEmit --skipLibCheck --project tsconfig.test.json && vitest run",
    "test:regressions": "node scripts/check-test-regressions.mjs",
    "lint:obsidian": "eslint src/ tests/",
    "lint:css": "stylelint styles.css",
    "lint:manifest": "node scripts/check-manifest.mjs",
    "check": "npm test && npm run build && npm run lint:obsidian && npm run lint:css && npm run lint:manifest",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "overrides": {
    "obsidian": {
      "moment": "^2.31.0"
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@typescript-eslint/parser": "^8.72.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jsdom": "30.1.3",
    "obsidian": "1.14.4",
    "playwright": "^1.64.1",
    "stylelint": "^17.16.0",
    "stylelint-config-obsidianmd": "^0.1.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
